node_modules/

# One HyperFrames workspace — everything regenerable stays out.
# capture/ is re-fetched with `hyperframes capture`, snapshots are rebuilt
# from the compositions, .thumbnails is Studio scratch.
# source-screens/ IS committed: those are the real captured app screens the
# videos are built from, and tracking them keeps this repo standalone.
# The root renders/ IS committed too: the published videos (see README).
snapshots/
.thumbnails/
compositions/*/capture/
compositions/*/snapshots/
compositions/*/.thumbnails/
compositions/*/source-footage/*
!compositions/*/source-footage/.gitkeep

# Recordings are large binaries — keep them out of git (renders/ excepted).
*.mov
*.MOV
*.mp4
*.MP4
!/renders/**
/renders/reel-60.mp4

# Browser-automation verification artifacts.
.playwright-mcp/

.DS_Store
